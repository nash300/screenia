{
  "name": "screenia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "text:check": "node scripts/check-text-quality.mjs",
    "style:check": "node scripts/check-style-boundaries.mjs",
    "billing:check": "node scripts/check-billing-invariants.mjs",
    "pricing:sync-components:test": "node scripts/sync-additional-setup-price.mjs",
    "pricing:verify-services": "node scripts/verify-pricing-services.mjs",
    "legal:sync": "node --env-file=.env.local scripts/sync-legal-documents.mjs",
    "admin-framework:check": "node scripts/check-admin-framework.mjs",
    "security:check": "node scripts/check-security-invariants.mjs && npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high",
    "stripe:replay-dispute": "node scripts/replay-stripe-dispute-event.mjs",
    "stripe:replay-refund": "node scripts/replay-stripe-refund-event.mjs",
    "qa:customers:seed": "node --env-file=.env.local scripts/qa-customers.mjs seed --confirm-screenia-qa",
    "qa:customers:verify": "node --env-file=.env.local scripts/qa-customers.mjs verify",
    "qa:customers:clean": "node --env-file=.env.local scripts/qa-customers.mjs clean --confirm-screenia-qa",
    "testing:reset": "node --env-file=.env.local scripts/reset-testing-state.mjs --confirm-screenia-reset",
    "release:check": "npm run test && npm run security:check && npm run lint && npm run text:check && npm run style:check && npm run billing:check && npm run admin-framework:check && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.105.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "22.1.0",
    "svix": "^1.96.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.12"
  }
}
